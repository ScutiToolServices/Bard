# Shared with armory and ember_api. Leave empty only for loopback-only use.
INTERNAL_API_TOKEN=
BARD_HOST=127.0.0.1
BARD_PORT=8090
# Docker only: address the published port listens on. 0.0.0.0 = reachable on the LAN (Zima dashboard link); 127.0.0.1 = this machine only.
BARD_BIND=0.0.0.0
# piper (default) or paradee. Paradee needs: uv sync --extra paradee
BARD_ENGINE=piper
# Optional: use the TTSPiperModel / TTSParadeeModel services (AI/ModelServices) instead of running the voices in Bard.
# Each token is made on that service's /admin/ page; its "projects" list limits the voices (Bard needs every voice it will offer).
# BARD_PIPER_URL=http://127.0.0.1:9150
# BARD_PIPER_TOKEN=
# BARD_PARADEE_URL=http://127.0.0.1:9160
# BARD_PARADEE_TOKEN=
# Default voice. Piper: en_US-lessac-medium. Paradee: af_heart, bf_isabella, am_puck or bm_fable.
BARD_VOICE=en_US-lessac-medium
BARD_MAX_CHARS=5000
BARD_TTL_HOURS=24
BARD_QUOTA_MB=200
BARD_MAX_CONCURRENT=1
# Unlocks the settings page at /admin/. Empty = page off. Saved settings win over the values above.
BARD_ADMIN_PASSWORD=

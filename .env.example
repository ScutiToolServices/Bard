# Copy to .env (git-ignored). run.bat loads it for a local run (--dotenv, names only are printed); Docker compose reads it from this folder; a real environment variable wins.
# Start-up values only. Limits, voice and ffmpeg are settings: change them on the admin page (/admin/); a saved value beats .env.
SERVICE_HOST=127.0.0.1
SERVICE_PORT=29400
# Docker only: 0.0.0.0 = reachable on the LAN (Zima dashboard link); 127.0.0.1 = this machine only.
SERVICE_BIND=0.0.0.0
# Unlocks /admin/ and turns token checks on for /mcp and /api. Create one token per caller (Armory, other services) on the page
# and give each caller its own. Required when SERVICE_HOST is not loopback; empty = no page and no checks (loopback only).
SERVICE_ADMIN_PASSWORD=
# Model service addresses and tokens are not set here: save them as connections on the admin page (/admin/).
# Its token's "projects" list must include every voice Bard offers.

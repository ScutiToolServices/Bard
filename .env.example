# Start-up values only. Limits, voice and ffmpeg are settings: change them on the admin page (/admin/); a saved value beats .env.
# Shared with armory and ember_api. Leave empty only for loopback-only use.
INTERNAL_API_TOKEN=
BARD_HOST=127.0.0.1
BARD_PORT=8090
# Docker only: 0.0.0.0 = reachable on the LAN (Zima dashboard link); 127.0.0.1 = this machine only.
BARD_BIND=0.0.0.0
# piper (default) or paradee. Paradee needs: uv sync --extra paradee
BARD_ENGINE=piper
# Unlocks /admin/ (settings, saved model connections, usage). Empty = page off.
BARD_ADMIN_PASSWORD=
# Optional first-run model services (TTSPiperModel / TTSParadeeModel). Empty = run the voices in Bard.
# Better: save them as connections on the admin page. Its token's "projects" list must include every voice Bard offers.
# BARD_PIPER_URL=http://127.0.0.1:9150
# BARD_PIPER_TOKEN=
# BARD_PARADEE_URL=http://127.0.0.1:9160
# BARD_PARADEE_TOKEN=
